# Build artefacts from the test suite.
#
# classic.html is regenerated by tools/template-render.test.php on every run and
# is the input tools/dom.test.mjs loads. Committing it would mean reviewing a
# 200KB generated diff on every change to a partial, and would let a stale copy
# be tested against.
classic.html
v2.html

# Showcase pages for design screenshots (tools/v2-showcase.php) — test data.
v2-ethereum.html
v2-bitcoin.html

node_modules/
package-lock.json

# Packaged plugin zips are built on demand by tools/package.sh.
thehybit-coins-*.zip
classic-themed.html

# Intermediate captures from tools/v2-screens.mjs; v2-compare.mjs merges them into screen-*.png
docs/v2-screens/ethereum-desktop-*.png
docs/v2-screens/ethereum-mobile-*.png
docs/v2-screens/bitcoin-mobile-full.png
docs/v2-screens/header-*.png
!docs/v2-screens/ethereum-desktop-full.png
